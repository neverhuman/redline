{
  "schema_version": "redline-testing-manifest-v1",
  "suite": "sqlite_parity",
  "command_line": [
    "redline-testing",
    "report",
    "--suite",
    "sqlite_parity",
    "--input",
    "benchmark-results/sqlite-parity/latest/raw.jsonl",
    "--priorities",
    "P0,P1,P2,P3,P4",
    "--profiles",
    "memory,tempfile,catalog,external_app,side_effect",
    "--include-quarantine",
    "--out-dir",
    "benchmark-results/sqlite-parity/latest",
    "--readme",
    "README.md",
    "--no-readme-latency",
    "--jankurai-score",
    ".jankurai/repo-score.json",
    "--updated-date",
    "2026-10-01",
    "--expected-repetitions",
    "3",
    "--expected-warmup",
    "1",
    "--official-evidence",
    "benchmark-results/sqlite-parity/latest/official-evidence.processed.json",
    "--run-provenance",
    "benchmark-results/sqlite-parity/latest/run-provenance.json"
  ],
  "repetitions": 3,
  "warmup": 1,
  "output_files": {
    "ranked": "benchmark-results/sqlite-parity/latest/ranked.csv",
    "raw": "benchmark-results/sqlite-parity/latest/raw.jsonl",
    "report_provenance": "benchmark-results/sqlite-parity/latest/report-provenance.json",
    "run_provenance": "benchmark-results/sqlite-parity/latest/run-provenance.json",
    "summary": "benchmark-results/sqlite-parity/latest/summary.json"
  }
}
