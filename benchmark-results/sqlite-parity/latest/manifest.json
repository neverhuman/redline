{
  "schema_version": "redline-testing-manifest-v1",
  "suite": "sqlite_parity",
  "command_line": [
    "redline-testing",
    "report",
    "--suite",
    "sqlite_parity",
    "--input",
    "benchmark-results/sqlite-parity/latest/raw.jsonl",
    "--priorities",
    "P0,P1,P2,P3,P4",
    "--profiles",
    "memory,tempfile,catalog,external_app,side_effect",
    "--include-quarantine",
    "--out-dir",
    "benchmark-results/sqlite-parity/latest",
    "--readme",
    "README.md",
    "--plot",
    "assets/sqlite-parity-latency-gap.svg",
    "--performance-histogram-plot",
    "assets/sqlite-parity-performance-histogram.svg",
    "--median-test-performance-plot",
    "assets/sqlite-median-test-performance.svg",
    "--jankurai-score",
    ".jankurai/repo-score.json",
    "--updated-date",
    "2026-09-24",
    "--expected-repetitions",
    "3",
    "--expected-warmup",
    "1",
