  "repetitions": 3,
  "warmup": 1,
  "output_files": {
    "ranked": "benchmark-results/sqlite-parity/latest/ranked.csv",
    "raw": "benchmark-results/sqlite-parity/latest/raw.jsonl",
    "report_provenance": "benchmark-results/sqlite-parity/latest/report-provenance.json",
    "summary": "benchmark-results/sqlite-parity/latest/summary.json"
