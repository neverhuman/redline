#!/usr/bin/env bash
set -euo pipefail
ops_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$ops_root/../.." && pwd)"
[[ -f "$root/subrepos.toml" ]] || {
  printf 'Use the complete https://github.com/neverhuman/RedlineDB checkout.\n' >&2
  exit 1
}
export REDLINE_REPO_ROOT="$root"
export CARGO_INCREMENTAL=0 CARGO_PROFILE_DEV_DEBUG=line-tables-only
exec cargo run --quiet --locked --manifest-path "$ops_root/Cargo.toml" \
  --target-dir "$root/target" -- "${@:-doctor}"
