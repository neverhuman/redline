# The one repository allowed to build and publish RedlineDB releases.
# scripts/package-release.sh and ops/ci/publish-github-release.sh source this
# file. install.sh repeats the slug and id because a piped installer cannot
# read it; scripts/test-installer.sh checks that they agree.
REDLINE_REPO_SLUG=neverhuman/redline
REDLINE_REPO_ID=1390165945
REDLINE_REPO_URL=https://github.com/neverhuman/redline
