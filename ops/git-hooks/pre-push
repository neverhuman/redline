#!/usr/bin/env bash
# Pre-push gate: run the exact PR CI mirror before letting any push leave
# the developer machine. The fast lane remains available for short repair
# loops, but this hook uses the same shard dispatchers as ci.yml.
# Audit reference: HLT-042 ci-local-parity.pre-push-hook-missing.

set -euo pipefail

root=$(git rev-parse --show-toplevel)
audit_dir="$root/target/review/pre-push-audit"
mkdir -p "$audit_dir"

echo "Running Jankurai audit..."
bash "$(git rev-parse --show-toplevel)/scripts/check_audit_policy_mirror.sh"
jankurai audit . --json "$audit_dir/repo-score.json" --md "$audit_dir/repo-score.md" --policy agent/audit-policy.toml --no-score-history

FINDINGS=$(grep -c 'Rule: `HLT-' "$audit_dir/repo-score.md" || true)
IGNORED=$(grep -E -c 'Rule: \`(HLT-001-DEAD-MARKER|HLT-018-PERF-CONCURRENCY-DRIFT)\`' "$audit_dir/repo-score.md" || true)
REAL_FINDINGS=$((FINDINGS - IGNORED))

if [ "$REAL_FINDINGS" -gt 0 ]; then
    echo "ERROR: Jankurai check failed with $REAL_FINDINGS issues (excluding known non-actionable config flags). Must be 0."
    exit 1
fi

CAPS=$(grep -o '"hard_findings":\s*[0-9]*' "$audit_dir/repo-score.json" | awk -F: '{print $2}' | tr -d ' ')
if [ "$CAPS" -gt 0 ]; then
    echo "ERROR: Jankurai check failed with $CAPS caps. Must be 0."
    exit 1
fi

echo "Jankurai check passed (0 caps, 0 issues)."
echo "Running local PR CI mirror..."
exec bash "$(git rev-parse --show-toplevel)/scripts/ci-local.sh" pr-ci
